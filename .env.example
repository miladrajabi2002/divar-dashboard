# ---------------------------------------------------------------------------
# Divar Dashboard – environment variables
#
# All of these are OPTIONAL. The OpenRouter API key and AI models can also be
# configured from the dashboard UI (Settings page), which is stored in the
# SQLite database and takes priority over these values.
# ---------------------------------------------------------------------------

# Path to the SQLite database file (created automatically on first migrate)
DATABASE_PATH=./divar.db

# OpenRouter API key for AI features — get yours at https://openrouter.ai/keys
# (Can also be set later from the dashboard Settings page.)
OPENROUTER_API_KEY=

# Default text model (titles / descriptions / analysis)
AI_MODEL=anthropic/claude-sonnet-4-6

# Default image model for banner generation (must support image output)
AI_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
